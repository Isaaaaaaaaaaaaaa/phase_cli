{
  "name": "svg-editor-cli",
  "version": "0.2.0",
  "description": "A plugin-extensible SVG CLI with VSCode and DSH integrations",
  "repository": { "type": "git", "url": "https://github.com/Isaaaaaaaaaaaaaa/phase_cli.git" },
  "type": "module",
  "files": [
    "dist",
    "doc",
    "docs",
    "plugins.config.json",
    "src/plugins/**/package.json"
  ],
  "bin": {
    "svg-editor": "dist/cli/SvgCli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/cli/SvgCli.js",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run build && npm run coverage",
    "test:vscode": "npm --prefix extensions/vscode-svg run test:host",
    "test:dsh": "npm --prefix integrations/dsh-svg test",
    "verify:assembly": "npm run build && node scripts/verify-assembly.mjs && node scripts/verify-ocp.mjs",
    "verify:baseline": "npm run build && node scripts/verify-baseline.mjs",
    "prepack": "npm run build",
    "metrics": "node scripts/metrics.mjs"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.1" }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.7.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^4.1.12"
  }
}
